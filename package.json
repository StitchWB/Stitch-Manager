{
  "name": "stitch-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "start:dev": "powershell -ExecutionPolicy Bypass -File start-dev.ps1",
    "dev": "npm run download:cloakbrowser && cargo watch -C src-tauri -w . -x \"run --bin stitch-manager\" --why",
    "dev:web": "vite --port 5174",
    "build": "npm exec tauri -- build",
    "build:web": "tsc && vite build",
    "build:extension": "vite build -c vite.extension.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:py": "pip install -r python/autoreg/requirements.txt",
    "download:cloakbrowser": "python python/autoreg/browser/download_cloakbrowser.py",
    "generate:types": "cargo run -p stitch-typescript-gen --bin generate_types --manifest-path src-tauri/Cargo.toml",
    "build:full": "npm run download:cloakbrowser && npm exec tauri -- build",
    "prebuild": "npm run generate:types",
    "validate:types": "powershell -ExecutionPolicy Bypass -File scripts/validate-types.ps1",
    "validate:types:unix": "bash scripts/validate-types.sh",
    "validate:type-sync": "node scripts/validate-type-sync.cjs",
    "validate:rust-serde": "node scripts/validate-rust-serde.cjs",
    "validate:tauri-types": "node scripts/validate-tauri-types.cjs",
    "validate:python-case": "python scripts/validate-python-case.py",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "validate:css": "node scripts/validate-tailwind.cjs",
    "validate:i18n": "node scripts/check-i18n-keys.cjs",
    "validate:all": "npm run validate:tauri-types && npm run validate:python-case && npm run validate:routes && npm run validate:i18n",
    "find:duplicate-types": "node scripts/find-duplicate-types.cjs",
    "test:patch": "node tests/kiro-patch-integration-test.cjs",
    "test:patch:verbose": "node tests/kiro-patch-integration-test.cjs --verbose",
    "test:patch:cdp": "node tests/kiro-cdp-test.cjs",
    "test:patch:cdp:verbose": "node tests/kiro-cdp-test.cjs --verbose --timeout=30000",
    "test:patch:full": "node tests/kiro-full-test.cjs",
    "test:patch:full:verbose": "node tests/kiro-full-test.cjs --verbose",
    "test:patch:full:keep": "node tests/kiro-full-test.cjs --no-unpatch",
    "test:patch:all": "node tests/patch-syntax-test.cjs && node tests/patch-inject-rollback-test.cjs && node tests/patch-spoofing-test.cjs && node tests/patch-network-test.cjs && node tests/patch-error-rate-test.cjs",
    "test:isolated:setup": "node tests/isolated-test/setup-isolated-env.cjs",
    "test:isolated:patch": "powershell tests/isolated-test/apply-patch-isolated.ps1",
    "test:isolated:run": "powershell tests/isolated-test/run-isolated-kiro.ps1",
    "test:isolated:test": "node tests/isolated-test/test-patch.cjs",
    "test:docker:build": "docker-compose -f tests/docker-isolated/docker-compose.yml build",
    "test:docker:up": "docker-compose -f tests/docker-isolated/docker-compose.yml up -d",
    "test:docker:down": "docker-compose -f tests/docker-isolated/docker-compose.yml down",
    "test:docker:logs": "docker-compose -f tests/docker-isolated/docker-compose.yml logs -f",
    "test:docker:test": "node tests/isolated-test/test-patch.cjs",
    "switch": "tauri node scripts/switch-account.mjs",
    "test": "npm run test:ts && npm run test:rust && npm run test:py",
    "test:ts": "jest",
    "test:ts:watch": "jest --watch",
    "test:ts:coverage": "jest --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --features test-utils",
    "test:rust:verbose": "cargo test --manifest-path src-tauri/Cargo.toml --features test-utils -- --nocapture",
    "test:py": "pytest python/tests",
    "test:py:verbose": "pytest python/tests -v",
    "test:py:coverage": "pytest python/tests --cov=python/autoreg --cov-report=html",
    "test:unit": "npm run test:ts && pytest python/tests -m unit",
    "test:integration": "pytest python/tests -m integration",
    "lint:ui-kit": "eslint \"src/**/*.tsx\" --rule \"@typescript-eslint/no-unused-vars:off\" --rule \"@typescript-eslint/no-explicit-any:off\" --rule \"no-console:off\" --rule \"react-hooks/exhaustive-deps:off\"",
    "lint:ui-imports": "eslint \"src/**/*.{ts,tsx}\" --rule \"@typescript-eslint/no-unused-vars:off\" --rule \"@typescript-eslint/no-explicit-any:off\" --rule \"no-console:off\" --rule \"react-hooks/exhaustive-deps:off\" --rule \"react/forbid-elements:off\" --rule \"no-restricted-syntax:off\" --rule \"react-hooks/rules-of-hooks:off\" --rule \"no-useless-escape:off\"",
    "lint:ui-kit:strict": "eslint \"src/**/*.tsx\" --rule \"@typescript-eslint/no-unused-vars:off\" --rule \"@typescript-eslint/no-explicit-any:off\" --rule \"no-console:off\" --rule \"react-hooks/exhaustive-deps:off\" --rule \"react/forbid-elements:error\"",
    "codemod:ui-kit:buttons": "node scripts/codemod-ui-kit-buttons.cjs",
    "codemod:ui-kit:buttons:dry": "node scripts/codemod-ui-kit-buttons.cjs --dry-run"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@headlessui/react": "^2.2.9",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "esprima": "^4.0.1",
    "framer-motion": "^12.24.10",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tauri": "^0.15.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/chrome": "^0.1.38",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "chrome-remote-interface": "^0.33.2",
    "eslint": "^8.57.1",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-ui-kit": "file:./eslint-plugin-ui-kit",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.47",
    "prettier": "^3.7.4",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "ws": "^8.19.0"
  }
}
