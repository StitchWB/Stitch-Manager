{
  "name": "stitch-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc && vite build",
    "start": "cd python && python run_gui.py",
    "start:dev": "cd python && python run_gui.py --dev",
    "dev:api": "cd python && uvicorn stitch_backend.main:app --reload --port 25584",
    "dev:web": "vite --port 5174",
    "build:web": "tsc && vite build",
    "build:extension": "vite build -c vite.extension.config.ts",
    "preview": "vite preview",
    "setup:py": "pip install -r python/requirements.txt",
    "download:cloakbrowser": "python python/autoreg/browser/download_cloakbrowser.py",
    "validate:all": "npm run validate:python-case && npm run validate:routes && npm run validate:i18n && npm run audit:contracts",
    "test": "npm run test:ts && npm run test:py",
    "test:ts": "jest",
    "test:py": "pytest python/tests",
    "lint:ui-kit": "eslint \"src/**/*.tsx\"",
    "audit:py": "python -m vulture python/autoreg",
    "audit:contracts": "python scripts/audit_contracts.py"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/dompurify": "^3.0.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.4",
    "framer-motion": "^12.24.10",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.47",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.1.1",
    "tsx": "^4.22.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
