{
  "name": "stitch-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "start:dev": "powershell -ExecutionPolicy Bypass -File start-dev.ps1",
    "dev": "cargo watch -C src-tauri -w . -x \"run --bin stitch-manager\" --why",
    "dev:web": "vite --port 5174",
    "build": "npm exec tauri -- build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:py": "pip install -r python/autoreg/requirements.txt",
    "validate:css": "node scripts/validate-tailwind.cjs",
    "test:patch": "node tests/kiro-patch-integration-test.cjs",
    "test:patch:verbose": "node tests/kiro-patch-integration-test.cjs --verbose",
    "test:patch:cdp": "node tests/kiro-cdp-test.cjs",
    "test:patch:cdp:verbose": "node tests/kiro-cdp-test.cjs --verbose --timeout=30000",
    "test:patch:full": "node tests/kiro-full-test.cjs",
    "test:patch:full:verbose": "node tests/kiro-full-test.cjs --verbose",
    "test:patch:full:keep": "node tests/kiro-full-test.cjs --no-unpatch",
    "test:patch:all": "node tests/patch-syntax-test.cjs && node tests/patch-inject-rollback-test.cjs && node tests/patch-spoofing-test.cjs && node tests/patch-network-test.cjs && node tests/patch-error-rate-test.cjs",
    "test:isolated:setup": "node tests/isolated-test/setup-isolated-env.cjs",
    "test:isolated:patch": "powershell tests/isolated-test/apply-patch-isolated.ps1",
    "test:isolated:run": "powershell tests/isolated-test/run-isolated-kiro.ps1",
    "test:isolated:test": "node tests/isolated-test/test-patch.cjs",
    "test:docker:build": "docker-compose -f tests/docker-isolated/docker-compose.yml build",
    "test:docker:up": "docker-compose -f tests/docker-isolated/docker-compose.yml up -d",
    "test:docker:down": "docker-compose -f tests/docker-isolated/docker-compose.yml down",
    "test:docker:logs": "docker-compose -f tests/docker-isolated/docker-compose.yml logs -f",
    "test:docker:test": "node tests/isolated-test/test-patch.cjs",
    "switch": "tauri node scripts/switch-account.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@headlessui/react": "^2.2.9",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esprima": "^4.0.1",
    "framer-motion": "^12.24.10",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "chrome-remote-interface": "^0.33.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.7.4",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "ws": "^8.19.0"
  }
}
