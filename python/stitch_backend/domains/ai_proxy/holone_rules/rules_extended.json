{
  "version": 1,
  "note": "Python-only rules ported from AegisGate (https://github.com/ax128/AegisGate, policies/rules/security_filters.yaml, MIT). These patterns use lookahead/lookbehind and are NOT RE2-compatible — they are loaded only by the Python engine, never synced into rules.json (which must stay RE2-pure for the Go HoloNe consumer). exfil_chain_* / exfil_persist_* ported byte-identical, including the load-bearing lookarounds: the leading (?=...) is a perf prefilter (188ms -> ms on 8KB), the .env(?!...) exclusion keeps .env.example templates benign, and (?:(?!&&)[^\\n]) keeps the persistence pair from crossing '&&' (mere adjacency is not the pair). Severity mirrors the AegisGate disposition: force_block/sanitize -> high, score-only -> medium.",
  "rules": [
    {
      "id": "exfil-chain-upload-credential-file",
      "category": "exfil",
      "severity": "high",
      "pattern": "\\b(?:curl|wget|ncat|nc|invoke-restmethod|invoke-webrequest|requests\\.(?:post|put))\\b(?=[^\\n]{0,300}?(?:credential|id_|config|netrc|npmrc|pypirc|pgpass|\\.env))[^\\n]{0,160}?(?:-T\\b|--upload-file|--post-file|-F\\b|--form|-d\\s*@|--data(?:-binary|-urlencode)?\\s*@|-Method\\s+P(?:ost|ut)|-InFile)[^\\n]{0,120}?(?:[/\\.](?:aws[/\\\\]credentials|ssh[/\\\\]id_\\w{2,12}|docker[/\\\\]config\\.json|kube[/\\\\]config)\\b|\\.(?:netrc|npmrc|pypirc|git-credentials|pgpass)\\b|\\.env(?!\\.(?:example|template|sample|dist))\\b)",
      "description": "Upload flag whose payload is a credential file (curl -T/-F/-d @ onto .aws/credentials, .ssh/id_*, .env...)"
    },
    {
      "id": "exfil-chain-upload-credential-store",
      "category": "exfil",
      "severity": "high",
      "pattern": "\\b(?:curl|wget|ncat|nc|invoke-restmethod|invoke-webrequest|requests\\.(?:post|put))\\b(?=[^\\n]{0,300}?(?:[/\\\\]\\.(?:aws|ssh|gnupg|kube|azure)|gcloud|login|cookies\\.sq|key4\\.db))[^\\n]{0,160}?(?:-T\\b|--upload-file|--post-file|-F\\b|--form|-d\\s*@|--data(?:-binary|-urlencode)?\\s*@|-Method\\s+P(?:ost|ut)|-InFile)[^\\n]{0,120}?(?:[/\\\\]\\.(?:aws|ssh|gnupg|kube|azure)\\b|[/\\\\]gcloud\\b|\\blogin[\\s\\\\]{0,2}data\\b|\\bcookies\\.sqlite\\b|\\bkey4\\.db\\b|\\blogins\\.json\\b|\\blogin\\.keychain\\b)",
      "description": "Upload flag whose payload is a credential directory or browser secret store"
    },
    {
      "id": "exfil-chain-credential-piped-out",
      "category": "exfil",
      "severity": "high",
      "pattern": "(?:(?:[/\\.](?:aws[/\\\\]credentials|ssh[/\\\\]id_\\w{2,12}|docker[/\\\\]config\\.json|kube[/\\\\]config)\\b|\\.(?:netrc|npmrc|pypirc|git-credentials|pgpass)\\b|\\.env(?!\\.(?:example|template|sample|dist))\\b)|(?:[/\\\\]\\.(?:aws|ssh|gnupg|kube|azure)\\b|[/\\\\]gcloud\\b|\\blogin[\\s\\\\]{0,2}data\\b|\\bcookies\\.sqlite\\b|\\bkey4\\.db\\b|\\blogins\\.json\\b|\\blogin\\.keychain\\b))[^\\n|]{0,160}?\\|\\s*(?:[a-z0-9_./-]{0,24}\\s+)?(?:curl|wget|ncat|nc|invoke-restmethod|invoke-webrequest)\\b",
      "description": "Credential artefact piped into a network command (cat ~/.aws/credentials | curl ...)"
    },
    {
      "id": "exfil-chain-env-dump-piped-out",
      "category": "exfil",
      "severity": "high",
      "pattern": "(?:(?<![.\\w/\\\\])(?:env|printenv)\\b|get-childitem\\s+env:|\\bdir\\s+env:)[^\\n|]{0,120}?\\|\\s*(?:[a-z0-9_./-]{0,24}\\s+)?(?:curl|wget|ncat|nc|invoke-restmethod|invoke-webrequest)\\b",
      "description": "Whole-environment dump piped into a network command (env | curl ...)"
    },
    {
      "id": "exfil-chain-recursive-secret-harvest",
      "category": "exfil",
      "severity": "high",
      "pattern": "\\b(?:grep|findstr|select-string|rg)\\b[^\\n|]{0,120}?(?:sk-|ghp_|AKIA|private\\s+key|api[_-]?key|secret|passw(?:or)?d|credential|\\*\\.env|\\.env\\b|id_rsa)[^\\n|]{0,120}?\\|\\s*(?:[a-z0-9_./-]{0,24}\\s+)?(?:curl|wget|ncat|nc|invoke-restmethod|invoke-webrequest)\\b",
      "description": "Recursive secret search piped into a network command (grep -r sk- ... | curl ...)"
    },
    {
      "id": "exfil-chain-secret-in-url-query",
      "category": "exfil",
      "severity": "high",
      "pattern": "[?&][a-z0-9_.-]{1,24}=(?:\\{\\{AG_[A-Z0-9]+_[A-Z0-9_]+_\\d+\\}\\}|(?:sk|rk|pk|ghp|gho|ghu|ghs|glpat|xoxb|xoxp)[-_][A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.)",
      "description": "Real secret shape carried in a URL query parameter"
    },
    {
      "id": "exfil-persist-autostart-remote-exec",
      "category": "persistence",
      "severity": "high",
      "pattern": "(?:crontab|/etc/cron\\.[a-z]{4,7}|/etc/systemd/system|\\.config/systemd/user|/Library/Launch(?:Agents|Daemons)|\\.bash(?:rc|_profile|_login)|\\.zshrc|\\.zprofile|\\.profile|/autostart/|\\\\Start\\s?Menu\\\\[^\\n]{0,20}Startup|HKCU[^\\n]{0,30}CurrentVersion\\\\Run)(?:(?!&&)[^\\n]){0,140}?(?:(?:curl|wget|iwr|irm)[^\\n|]{0,60}\\|\\s*(?:sudo\\s+)?(?:ba|z|k)?sh\\b|/dev/tcp/|invoke-expression|\\biex\\s*[\\( ]|\\bnc\\s+-[a-z]*e\\s|base64\\s+-{1,2}d[^\\n|]{0,30}\\|\\s*(?:ba)?sh\\b)",
      "description": "Autostart surface + fetch-and-run payload in one line (persistence pair)"
    },
    {
      "id": "exfil-persist-autostart-reversed",
      "category": "persistence",
      "severity": "high",
      "pattern": "(?:(?:curl|wget|iwr|irm)[^\\n|]{0,60}\\|\\s*(?:sudo\\s+)?(?:ba|z|k)?sh\\b|/dev/tcp/|invoke-expression|\\biex\\s*[\\( ]|\\bnc\\s+-[a-z]*e\\s|base64\\s+-{1,2}d[^\\n|]{0,30}\\|\\s*(?:ba)?sh\\b)(?:(?!&&)[^\\n]){0,140}?(?:crontab|/etc/cron\\.[a-z]{4,7}|/etc/systemd/system|\\.config/systemd/user|/Library/Launch(?:Agents|Daemons)|\\.bash(?:rc|_profile|_login)|\\.zshrc|\\.zprofile|\\.profile|/autostart/|\\\\Start\\s?Menu\\\\[^\\n]{0,20}Startup|HKCU[^\\n]{0,30}CurrentVersion\\\\Run)",
      "description": "Fetch-and-run payload + autostart surface, reversed order (payload | crontab -)"
    },
    {
      "id": "exfil-egress-markdown-image-secret",
      "category": "exfil",
      "severity": "high",
      "pattern": "!\\[[^\\]]{0,80}\\]\\(\\s*https?://[^\\s)]{0,120}[?&][a-z0-9_.-]{1,24}=(?:\\{\\{AG_[A-Z0-9]+_[A-Z0-9_]+_\\d+\\}\\}|(?:sk|rk|pk|ghp|gho|ghu|ghs|glpat|xoxb|xoxp)[-_][A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16}|eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.)",
      "description": "Markdown image whose URL query carries a secret — the renderer fetches it, no click needed"
    },
    {
      "id": "impersonate-multi-tool-use-parallel",
      "category": "impersonation",
      "severity": "medium",
      "pattern": "to\\s*=\\s*mult[i_]*[_\\s]*tool[_\\s]*use[\\._\\s]*parall",
      "description": "Text imitating the multi_tool_use.parallel recipient protocol"
    },
    {
      "id": "impersonate-tool-uses-json",
      "category": "impersonation",
      "severity": "medium",
      "pattern": "[(\"']\\s*tool_uses?\\s*[)\"']\\s*[:=\\[]",
      "description": "Forged tool_use(s) JSON key in plain text — tool-call format impersonation"
    },
    {
      "id": "impersonate-function-call-json",
      "category": "impersonation",
      "severity": "medium",
      "pattern": "[(\"']\\s*function_calls?\\s*[)\"']\\s*[:=\\[]",
      "description": "Forged function_call(s) JSON key in plain text — tool-call format impersonation"
    },
    {
      "id": "impersonate-fake-assistant-tool-block",
      "category": "impersonation",
      "severity": "medium",
      "pattern": "D\\s*\\(\\s*[\"']\\s*tool_uses?\\s*[\"']",
      "description": "Serialized fake assistant tool block (D(\"tool_uses\":...)) — protocol hijack"
    },
    {
      "id": "impersonate-recipient-name",
      "category": "impersonation",
      "severity": "medium",
      "pattern": "recipient_name[\"']\\s*:\\s*[\"']functions?\\.",
      "description": "recipient_name pointing at the internal functions.* namespace"
    },
    {
      "id": "impersonate-functions-namespace",
      "category": "impersonation",
      "severity": "medium",
      "pattern": "functions?\\.\\s*(?:ls|exec|eval|run|read|write|delete|rm|cat|curl|wget|sh|bash|python|node|open|spawn|system)\\b",
      "description": "functions.<command> namespace invocation written out as text"
    },
    {
      "id": "sysleak-disclosure-en",
      "category": "client-config",
      "severity": "medium",
      "pattern": "(?:my\\s+(?:system\\s+)?(?:prompt|instructions?)\\s+(?:say|says|read|state|include|tell\\s+me)\\s*[::]|(?:here\\s+is|following\\s+is|below\\s+is)\\s+my\\s+(?:system\\s+)?(?:prompt|instructions?)\\s*[::]|i\\s+(?:was|am|have\\s+been)\\s+(?:told|instructed|configured|programmed)\\s+(?:not\\s+)?to\\s+(?:reveal|share|disclose|discuss|mention)\\s)",
      "description": "Assistant disclosing its own system prompt (provider-side leak or injected self-description)"
    },
    {
      "id": "shell-injection-chain",
      "category": "download-exec",
      "severity": "medium",
      "pattern": "(?:;|\\|\\||&&|\\|)\\s*(?:curl|wget|bash|sh|nc|ncat|powershell|cmd(?:\\.exe)?)\\b",
      "description": "Shell separator chained to a network/interpreter command"
    },
    {
      "id": "shell-injection-scripting",
      "category": "download-exec",
      "severity": "medium",
      "pattern": "(?:;|\\|\\||&&|\\|)\\s*(?:python[23]?|perl|ruby|php)\\s+-[ce]\\b",
      "description": "Shell separator chained to inline script execution (-c/-e)"
    },
    {
      "id": "encoded-base64-long",
      "category": "obfuscation",
      "severity": "medium",
      "pattern": "[A-Za-z0-9+/]{200,}={0,2}",
      "description": "Long raw base64 blob (200+ chars) — encoded payload candidate"
    },
    {
      "id": "encoded-hex-long",
      "category": "obfuscation",
      "severity": "medium",
      "pattern": "\\b[0-9a-fA-F]{300,}\\b",
      "description": "Long hex blob (300+ chars) — encoded payload candidate"
    }
  ]
}
